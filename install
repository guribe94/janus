#!/usr/bin/env python3
"""Install janus: a release, links, hooks, watcher, tools. `install --dry-run` prints every change and changes nothing.
Usage: install [--dry-run] [--project DIR] [--no-hosts] [--hosts-only] [--release-only] [--stage-only] [--rollback] [--tests PATTERN]
  (DIR holds .janus/janus.toml; default: current directory or a parent)

Releases are immutable: the PARTS (janus.py and the package, skill/, docs/, ...) are copied into ~/.local/share/janus/releases/<version>/
(read-only) and smoke-checked there (the package imports, `--help`, two hook calls); `--tests PATTERN` also runs only the named
tests/test_*.py files against the copy (no whole suite is run unless you ask for it with a pattern that matches it). Only then
~/.local/share/janus/current is switched with one atomic rename. `--stage-only` builds and checks the release and switches nothing.
~/.local/bin/janus -> current/janus.py; the skill is linked where each tool reads it: ~/.claude/skills/janus (Claude Code, and
opencode, which reads that folder) and ~/.agents/skills/janus (Codex; an older ~/.codex/skills/janus link is refreshed, never
created). A release that a running process or a queued job still names is never pruned; when that cannot be told, nothing is pruned."""
import argparse, ast, hashlib, json, os, shlex, shutil, subprocess, sys, time, tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent; HOME = Path.home()
ap = argparse.ArgumentParser(); ap.add_argument("--dry-run", action="store_true"); ap.add_argument("--project"); ap.add_argument("--no-hosts", action="store_true"); ap.add_argument("--hosts-only", action="store_true")
ap.add_argument("--release-only", "--pin-only", action="store_true", help="only build, test and switch to a new release of janus.py and the skill")
ap.add_argument("--rollback", action="store_true", help="switch current back to the previous release")
ap.add_argument("--stage-only", action="store_true", help="build and check the release, switch nothing")
ap.add_argument("--tests", metavar="PATTERN", help="also run the tests/ files matching this unittest pattern (e.g. test_migrate.py) against the copy")
A = ap.parse_args(); DRY = A.dry_run
EVENTS = {"SessionStart": None, "PreToolUse": "Bash|Edit|Write|MultiEdit|NotebookEdit|apply_patch", "Stop": None}   # no UserPromptSubmit: janus no longer files the user's prompts
OLD_EVENTS = ("UserPromptSubmit",)
JANUS = HOME / ".local/bin/janus"
SHARE = HOME / ".local/share/janus"; REL = SHARE / "releases"; CUR = SHARE / "current"
PARTS = ["janus.py", "janus", "board.sh", "skill", "docs", "example.janus.toml", "launchd", "heartbeat", "tests"]
KEEP = 5   # releases kept (current and the newest others)

def say(m): print(("[dry-run] " if DRY else "") + m, flush=True)
def run(cmd, shell=False):
    say("run: " + (cmd if shell else shlex.join(cmd)))
    if not DRY and subprocess.run(cmd, shell=shell).returncode: print("  failed (continuing)", file=sys.stderr)

def swap_link(dst, target):
    """Point the symlink dst at target with one atomic rename (a temp link renamed over it)."""
    tmp = dst.with_name(f".{dst.name}.tmp{os.getpid()}"); tmp.unlink(missing_ok=True); tmp.symlink_to(target); os.replace(tmp, dst)

def ours(dst):
    """dst is a link install may replace: one into ~/.local/share/janus, or (older installs) into a janus working tree."""
    if not dst.is_symlink(): return False
    t = Path(os.readlink(dst)); t = t if t.is_absolute() else dst.parent / t
    return str(t).startswith(str(SHARE)) or (t.parent / "janus.py").is_file() or t.name in ("janus.py", "skill")

def link(dst, target):
    dst = Path(dst).expanduser()
    if dst.is_symlink() and os.readlink(dst) == str(target): say(f"link ok: {dst} -> {target}"); return
    if dst.exists() and not dst.is_symlink(): say(f"SKIP {dst} exists and is not a link: move it away, then rerun"); return
    if dst.is_symlink() and not ours(dst): say(f"SKIP {dst} is a link to {os.readlink(dst)}, not janus's"); return
    say(f"link {dst} -> {target}")
    if not DRY: dst.parent.mkdir(parents=True, exist_ok=True); swap_link(dst, target)

def version():
    h = hashlib.sha256()
    for part in PARTS:
        p = HERE / part
        for f in sorted([p] if p.is_file() else [x for x in p.rglob("*") if x.is_file() and "__pycache__" not in x.parts]):
            h.update(str(f.relative_to(HERE)).encode()); h.update(f.read_bytes())
    return time.strftime("%Y%m%d-%H%M%S-") + h.hexdigest()[:10], h.hexdigest()[:10]

def smoke(d):
    py = [sys.executable, str(d / "janus.py")]
    ast.parse((d / "janus.py").read_bytes())
    r = subprocess.run([sys.executable, "-c", "import janus"], cwd=d, capture_output=True, text=True, env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"})
    if r.returncode: return f"the package does not import from the copy: {r.stderr.strip()[-300:]}"
    for args, inp in ((["--help"], None), (["hook", "PreToolUse"], "{}"), (["hook", "Stop"], "{}")):
        r = subprocess.run(py + args, input=inp, capture_output=True, text=True)
        if r.returncode: return f"janus.py {' '.join(args)} failed: {r.stderr.strip()[-300:]}"
    if A.tests and (d / "tests").is_dir():   # only the named test files, against the copy (tests/janusload.py loads its janus)
        env = {k: v for k, v in os.environ.items() if k not in ("JANUS_ROOT", "JANUS_UNIT", "JANUS_ROLE", "JANUS_REPORT")}
        r = subprocess.run([sys.executable, "-m", "unittest", "discover", "-q", "-s", "tests", "-p", A.tests], cwd=d, capture_output=True, text=True,
                           env={**env, "JANUS_PY": str(d / "janus.py"), "PYTHONDONTWRITEBYTECODE": "1"})
        if r.returncode:
            log = SHARE / "release-check-failed.log"; log.write_text(r.stdout + r.stderr)
            return f"tests {A.tests} failed (every failure: {log}):\n" + (r.stderr or r.stdout)[-1500:]
    return None

import re
def generated_launcher(p):
    """p is a regular file that is exactly the launcher `janus install-host` writes (`#!/bin/sh` + `exec python3 <root>/janus/janus.py "$@"`):
    the one non-link janus may replace with its link. Any other file is the user's and is never touched."""
    try: return p.is_file() and not p.is_symlink() and re.fullmatch(r'#!/bin/sh\nexec python3 \S+/janus/janus\.py "\$@"\n', p.read_text()) is not None
    except (OSError, UnicodeDecodeError): return False

def check_launcher():
    """Refuse BEFORE the release is switched (not after: current then pointed at a release whose links were refused)."""
    if JANUS.exists() and not JANUS.is_symlink() and not generated_launcher(JANUS): sys.exit(f"{JANUS} exists and is neither a symlink nor janus's own generated launcher: not replaced, nothing installed (move it away, then rerun)")

def old_layout_projects():
    """Registered projects still on the old layout (a janus.toml at the top, no .janus/janus.toml): the new janus cannot find their
    state, so a switch of the live release must wait for `janus migrate` of each (or for the root agent to pin them)."""
    pl = HOME / ".config/janus/projects"
    return [x for x in (pl.read_text().split() if pl.is_file() else []) if (Path(x) / "janus.toml").is_file() and not (Path(x) / ".janus" / "janus.toml").is_file()]

def refuse_old_layout():
    old = old_layout_projects()
    if not old: return
    msg = ("refusing to activate: registered project(s) still on the old layout: " + ", ".join(old) + ". Activation would leave them without a working janus. "
           "Migrate each first (janus migrate OLD_ROOT --to PROJECT, dry run, then --apply with no jobs or agents running), or pin them to the "
           "current release; `install --stage-only` builds and checks a release without switching anything.")
    if DRY: say("WOULD REFUSE: " + msg); return
    sys.exit(msg)

def release():
    """Build releases/<version> from this tree, test the copy, switch current to it atomically, point the links at current."""
    for part in PARTS[:3]:
        if not (HERE / part).exists(): sys.exit(f"{HERE / part} missing")
    check_launcher()
    if not A.stage_only: refuse_old_layout()
    v, h = version()
    have = [d for d in REL.glob(f"*-{h}") if d.is_dir()] if REL.is_dir() else []
    d = have[0] if have else REL / v
    say(f"release {d.name}" + (" (this content is already built)" if have else ""))
    if DRY: say(f"copy {', '.join(PARTS)} -> {d}; smoke-check the copy" + ("" if A.stage_only else f"; switch {CUR} -> {d}; {JANUS} -> {CUR}/janus.py; skill links -> {CUR}/skill")); return
    if not have:
        st = REL / f".staging-{os.getpid()}"; shutil.rmtree(st, ignore_errors=True); st.mkdir(parents=True)
        for part in PARTS:
            src = HERE / part
            if src.is_dir(): shutil.copytree(src, st / part, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
            elif src.is_file(): shutil.copy2(src, st / part)
        (st / "VERSION").write_text(f"{v}\nfrom {HERE}\n" + subprocess.run(["git", "-C", str(HERE), "describe", "--always", "--dirty"], capture_output=True, text=True).stdout)
        why = smoke(st)
        if why: shutil.rmtree(st, ignore_errors=True); sys.exit(f"release NOT installed: {why}")
        for f in st.rglob("*"):
            if f.is_file(): f.chmod(0o555 if f.name == "janus.py" or os.access(f, os.X_OK) else 0o444)   # scripts (heartbeat/) stay runnable
        os.rename(st, d)
    else:
        why = smoke(d)
        if why: sys.exit(f"release NOT installed: {why}")
    if A.stage_only: say(f"staged {d}: checked, not switched"); return
    prev = os.readlink(CUR) if CUR.is_symlink() else None
    swap_link(CUR, d); say(f"{CUR} -> {d}" + (f" (was {prev})" if prev else ""))
    finish_links(); prune()

def finish_links():
    check_launcher()
    if generated_launcher(JANUS): say(f"migrate {JANUS}: janus's generated launcher (install-host) -> link to {CUR}/janus.py"); swap_link(JANUS, CUR / "janus.py")
    link(JANUS, CUR / "janus.py")
    link(HOME / ".claude/skills/janus", CUR / "skill"); link(HOME / ".agents/skills/janus", CUR / "skill")
    old = HOME / ".codex/skills/janus"
    if old.is_symlink(): link(old, CUR / "skill")   # an older install's link follows the release; none is made where there was none

def in_use():
    """Names of the releases a running process or a queued/running pueue job still names, or None when that cannot be told."""
    try:
        ps = subprocess.run(["ps", "-axo", "command"], capture_output=True, text=True, timeout=30).stdout
        pq = subprocess.run(["pueue", "status", "--json"], capture_output=True, text=True, timeout=30) if shutil.which("pueue") else None
    except (OSError, subprocess.SubprocessError): return None
    if pq is not None and pq.returncode: return None   # a queue that does not answer: unknown, not "none"
    text = ps + (pq.stdout if pq else "")
    return set(re.findall(r"releases/([0-9]{8}-[0-9]{6}-[0-9a-f]{10})", text))

def prune():
    cur = Path(os.readlink(CUR)).name if CUR.is_symlink() else ""
    rels = sorted(x for x in REL.iterdir() if x.is_dir() and not x.name.startswith("."))
    old = [x for x in rels[:-KEEP] if x.name != cur]
    if not old: return
    used = in_use()
    if used is None: say("not pruning: what runs or is queued cannot be told now"); return
    for x in old:
        if x.name in used: say(f"keep release {x.name}: a running process or a queued job names it")
        else: say(f"remove old release {x.name}"); shutil.rmtree(x, ignore_errors=True)

def rollback():
    rels = sorted(x for x in REL.iterdir() if x.is_dir() and not x.name.startswith(".")) if REL.is_dir() else []
    cur = Path(os.readlink(CUR)).name if CUR.is_symlink() else ""
    older = [x for x in rels if x.name < cur]
    if not older: sys.exit("no older release to roll back to")
    say(f"rollback: {CUR} -> {older[-1]}")
    if not DRY: swap_link(CUR, older[-1])

def linux_watcher(project):
    """Linux: a systemd user timer runs `janus watch` in each project every 2 min (the launchd agent's counterpart)."""
    u = HOME / ".config/systemd/user"
    svc = ("[Unit]\nDescription=janus watch\n[Service]\nType=oneshot\nExecStart=/bin/sh -c '[ -f %h/.config/janus/projects ] || exit 0; "
           "while read -r p; do [ -d \"$p\" ] && (cd \"$p\" && %h/.local/bin/janus watch); done < %h/.config/janus/projects'\n")
    tmr = "[Unit]\nDescription=janus watch every 2 min\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=2min\n[Install]\nWantedBy=timers.target\n"
    say(f"write {u}/janus-watch.service and .timer; enable the timer")
    if not DRY: u.mkdir(parents=True, exist_ok=True); (u / "janus-watch.service").write_text(svc); (u / "janus-watch.timer").write_text(tmr)
    pl = HOME / ".config/janus/projects"; have = pl.read_text().split() if pl.exists() else []
    if project and str(project) not in have and not DRY: pl.parent.mkdir(parents=True, exist_ok=True); pl.write_text("\n".join([*have, str(project)]) + "\n")
    run(["systemctl", "--user", "daemon-reload"]); run(["systemctl", "--user", "enable", "--now", "janus-watch.timer"])

def drop_old_hooks(data):
    """Remove only janus's own entries of events it no longer uses; returns the events changed."""
    gone = []
    for ev in OLD_EVENTS:
        lst = data.get("hooks", {}).get(ev)
        if not lst: continue
        keep = [e for e in lst if not any(f"janus hook {ev}" in h.get("command", "") for h in e.get("hooks", []))]
        if len(keep) != len(lst):
            gone.append(ev)
            if keep: data["hooks"][ev] = keep
            else: del data["hooks"][ev]
    return gone

def merge_hooks(path):
    path = Path(path).expanduser()
    data = json.loads(path.read_text()) if path.exists() else {}
    hooks = data.setdefault("hooks", {}); added = []; dropped = drop_old_hooks(data)
    for ev, matcher in EVENTS.items():
        cmd = f"{JANUS} hook {ev}"
        lst = hooks.setdefault(ev, [])
        if any(cmd in h.get("command", "") for e in lst for h in e.get("hooks", [])): continue
        ent = {"hooks": [{"type": "command", "command": cmd, "timeout": 60}]}
        if matcher: ent["matcher"] = matcher
        lst.append(ent); added.append(ev)
    if not added and not dropped: say(f"hooks ok: {path}"); return
    say(f"hooks {path}: add {', '.join(added) or '-'}; drop janus's own {', '.join(dropped) or '-'} (existing keys and hooks kept; backup first)")
    if DRY: return
    if path.exists(): path.with_name(path.name + f".bak-janus-{int(time.time())}").write_text(path.read_text())
    path.parent.mkdir(parents=True, exist_ok=True); path.write_text(json.dumps(data, indent=2) + "\n")

def watcher(project):
    plist = HOME / "Library/LaunchAgents/com.janus.watch.plist"
    say(f"copy launchd/com.janus.watch.plist -> {plist}")
    if not DRY:
        plist.parent.mkdir(parents=True, exist_ok=True); (HOME / ".config/janus").mkdir(parents=True, exist_ok=True)
        plist.write_text((HERE / "launchd/com.janus.watch.plist").read_text().replace("__HOME__", str(HOME)))
    pl = HOME / ".config/janus/projects"; have = pl.read_text().split() if pl.exists() else []
    if project and str(project) not in have:
        say(f"add {project} to {pl}")
        if not DRY: pl.parent.mkdir(parents=True, exist_ok=True); pl.write_text("\n".join([*have, str(project)]) + "\n")
    run(["launchctl", "bootout", f"gui/{os.getuid()}/com.janus.watch"]) if plist.exists() else None
    run(["launchctl", "bootstrap", f"gui/{os.getuid()}", str(plist)])

def host_tools(name, h, root):
    """A remote host's setup is janus install-host's: it discovers the host first (OS, arch, tools), then folders, pueued as a
    user service, a copy of janus for read-only commands, the heartbeat watchdog when configured (the installed release's janus)."""
    if h.get("local"): return
    me = CUR / "janus.py" if (CUR / "janus.py").exists() else HERE / "janus.py"
    run(["sh", "-c", f"cd {shlex.quote(str(root))} && {shlex.quote(sys.executable)} {shlex.quote(str(me))} install-host {shlex.quote(name)}"])

def main():
    root = None
    p = Path(A.project or os.getcwd()).resolve()
    for d in [p, *p.parents]:
        if (d / ".janus" / "janus.toml").is_file(): root = d; break
    if A.rollback: rollback(); return
    if A.release_only or A.stage_only: release(); return
    if A.hosts_only:
        for n, h in tomllib.loads((root / ".janus" / "janus.toml").read_text()).get("hosts", {}).items(): host_tools(n, h, root)
        return
    say("== release and links ==")
    release()
    say("== hooks ==")
    merge_hooks("~/.claude/settings.json"); merge_hooks("~/.codex/hooks.json")
    say("   (Codex: trust the hooks once with /hooks)")
    say("== watcher ==")
    if sys.platform == "darwin": watcher(root)
    else: linux_watcher(root)
    say("== tools ==")
    if sys.platform == "darwin":
        # install only what is missing (a reinstall every run restarts pueue and disturbs queued jobs)
        formulas = [f for t, f in (("bd", "beads"), ("pueue", "pueue")) if not shutil.which(t)]
        if formulas: run(["brew", "install", *formulas])
        answers = shutil.which("pueue") and subprocess.run(["pueue", "status"], capture_output=True).returncode == 0
        if not answers: run(["brew", "services", "start", "pueue"])
    if root and not A.no_hosts:
        for n, h in tomllib.loads((root / ".janus" / "janus.toml").read_text()).get("hosts", {}).items(): host_tools(n, h, root)
    elif not root: say("no .janus/janus.toml found: host tools skipped")

main()

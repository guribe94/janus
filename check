#!/bin/sh
# Cheap checks a change must pass before ./install: parse, package import, --help, two hook calls, run against a copy of exactly
# what install ships (its PARTS), so a file the code needs but install leaves out fails here. No test suite runs unless you name
# one: ./check test_migrate.py test_monitor.py (unittest file patterns under tests/, run against the same copy).
set -e
cd "$(dirname "$0")"
python3 -c 'import ast; ast.parse(open("janus.py").read()); ast.parse(open("install").read())'
ship=$(mktemp -d); trap 'rm -rf "$ship"' EXIT
python3 - "$ship" <<'PY'
import ast, shutil, sys
from pathlib import Path
parts = next(ast.literal_eval(n.value) for n in ast.parse(open("install").read()).body
             if isinstance(n, ast.Assign) and getattr(n.targets[0], "id", "") == "PARTS")
for p in parts:
    src, dst = Path(p), Path(sys.argv[1]) / p
    if src.is_dir(): shutil.copytree(src, dst, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
    elif src.is_file(): shutil.copy2(src, dst)
PY
(cd "$ship" && PYTHONDONTWRITEBYTECODE=1 python3 -c 'import janus' && python3 janus.py --help >/dev/null \
  && echo '{}' | python3 janus.py hook PreToolUse >/dev/null && echo '{}' | python3 janus.py hook Stop >/dev/null)
echo "smoke ok"
for p in "$@"; do
  (cd "$ship" && env -u JANUS_ROOT -u JANUS_UNIT -u JANUS_ROLE -u JANUS_REPORT JANUS_PY="$ship/janus.py" PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p "$p" 2>&1 | tail -6)
done
